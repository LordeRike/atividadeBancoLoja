   // 1. Método para Inserir (INSERT)
   public static void inserirCliente(String nome, String endereco) {
       String sql = "INSERT INTO cliente (nome, endereco) VALUES (?, ?)";

       try (Connection conn = DriverManager.getConnection(URL, USER, PASS);
            PreparedStatement pstmt = conn.prepareStatement(sql)) {

           pstmt.setString(1, nome);
           pstmt.setString(2, endereco);
           pstmt.executeUpdate();

           System.out.println("Cliente inserido com sucesso!");
           System.out.println("");

        } catch (SQLException e) {
           System.err.println("Erro ao inserir cliente: " + e.getMessage());
        }    
   }

   // 2. Método para Consultar (SELECT)
   public static void listarClientes() {
       String sql = "SELECT id_cliente, nome, endereco FROM cliente";

       try (Connection conn = DriverManager.getConnection(URL, USER, PASS);
            PreparedStatement pstmt = conn.prepareStatement(sql);
            ResultSet rs = pstmt.executeQuery()) {

           System.out.println("\n--- LISTA DE CLIENTES NO BANCO ---");
           while (rs.next()) {
               int id = rs.getInt("id_cliente");
               String nome = rs.getString("nome");
               String endereco = rs.getString("endereco");

               System.out.printf("ID: %d | Nome: %s | Endereço: %s%n", id, nome, endereco);
               System.out.println("===========================================");
               
            }

        } catch (SQLException e) {
           System.err.println("Erro ao listar clientes: " + e.getMessage());
        }
    }
   

   // 3. Método para consultar um cliente
   public static void buscaCliente() {
        Scanner leitor = new Scanner(System.in);

        System.out.println("== Busca de cliente ==");
        System.out.print("== Digite o ID do cliente: ");
        int busca_cliente = leitor.nextInt();
        leitor.nextLine();

        String sql = "SELECT * FROM cliente WHERE (id_cliente = "+busca_cliente+")";

        try (Connection conn = DriverManager.getConnection(URL, USER, PASS);
            PreparedStatement pstmt = conn.prepareStatement(sql);
            ResultSet rs = pstmt.executeQuery()) {

            System.out.println("\n--- CLIENTE NO BANCO ---");
            while (rs.next()) {
                int id = rs.getInt("id_cliente");
                String nome = rs.getString("nome");
                String endereco = rs.getString("endereco");

                System.out.printf("ID: %d | Nome: %s | Endereço: %s%n", id, nome, endereco);
                System.out.println("===========================================");
                
            }

        } catch (SQLException e) {
            System.err.println("Erro ao listar cliente: " + e.getMessage());
        }
        
    }

    // 4. Metodo inserir tabela produto
    public static void inserirProduto(String descricao, int quantidade_estoque) {
        String sql = "INSERT INTO produtos (descricao, quantidade_estoque) VALUES ( ?, ?)";
 
